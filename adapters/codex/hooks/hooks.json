{
  "description": "Enforce PrdCheckpoint source-mutation and yield guards after a PRD gate is attested in this repository.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|exec_command|write_stdin",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_use.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop.py"
          }
        ]
      }
    ]
  }
}
